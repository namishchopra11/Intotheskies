{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "start"
      ],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "phone-demo",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-c",
        "export PATH=$HOME/.local/node/bin:$PATH; pnpm build && pnpm exec next start -H 0.0.0.0 -p 3100"
      ],
      "port": 3100
    },
    {
      "name": "web-dev",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-c",
        "export PATH=$HOME/.local/node/bin:$PATH; pnpm exec next dev -p ${PORT:-3000}"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}
